{
  "project_name": "AI Documentary Factory",
  "version": "1.0.0",
  "description": "Fully autonomous AI documentary research, production and publishing system.",

  "storage": {
    "provider": "local",
    "local_dir": "storage",
    "s3_bucket": "",
    "s3_prefix": "documentaries"
  },

  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "target_duration_minutes": 22,
    "test_duration_seconds": 12,
    "scene_duration_seconds": 6,
    "transition": "fade",
    "subtitle_font_size": 42,
    "background_music_volume": 0.12,
    "narration_volume": 1.0
  },

  "content": {
    "languages": ["hi", "en"],
    "categories": [
      "stone_age",
      "ancient",
      "medieval",
      "modern",
      "islamic_history",
      "world_history"
    ],
    "min_freshness_days": 30,
    "topic_score_threshold": 0.55
  },

  "voice": {
    "engine": "auto",
    "kingvoice_repo_path": "../kingvoice",
    "voice_hi": "hindi_male",
    "voice_en": "english_male",
    "default_emotion": "dramatic",
    "pause_between_scenes_ms": 320
  },

  "research": {
    "use_ai_when_available": true,
    "facts_per_topic": 8,
    "offline_knowledge_base": true
  },

  "upload": {
    "enabled": false,
    "privacy": "private",
    "notify_subscribers": false,
    "schedule_enabled": false,
    "dry_run": true
  },

  "analytics": {
    "enabled": true,
    "optimize_upload_time": true,
    "min_samples_for_optimization": 5
  },

  "notifications": {
    "console": true,
    "webhook_url": ""
  },

  "scheduler": {
    "timezone": "Asia/Kolkata",
    "cron": "0 3 * * *",
    "max_videos_per_day": 1
  },

  "paths": {
    "data_dir": "data",
    "logs_dir": "logs"
  }
}
