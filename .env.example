# ---------------------------------------------------------------------------
# Copy to .env and fill in what you use. NEVER commit .env.
# In GitHub Actions these become repository Secrets -> environment variables.
# Leave AI_API_KEY empty to run in fully-offline demo mode.
# ---------------------------------------------------------------------------

# AI research + script writing (OpenAI-compatible endpoint: OpenAI, Groq, Together, Ollama...)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Image generation (optional). Empty => cinematic placeholder frames via FFmpeg.
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# Existing local voice repository (King Voice 👑). Auto-detected if omitted.
KINGVOICE_REPO_PATH=../kingvoice
VOICE_ENGINE=auto

# External asset storage (s3 | local). Large MP4/MP3 files stay OUT of git.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Master automation switch (OFF pauses every scheduled stage)
AUTOMATION_ENABLED=true

# YouTube upload / analytics (UPLOAD IS DISABLED BY DEFAULT — dry run only)
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_CHANNEL_ID=

# Notifications
NOTIFY_WEBHOOK_URL=

# Dashboard
DASHBOARD_SECRET=change-me
DASHBOARD_PORT=8080

# Where runtime files live (defaults to this repository)
AUTOMATION_ROOT=
