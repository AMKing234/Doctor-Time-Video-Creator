# ---------------------------------------------------------------------------
# Copy to .env and fill in what you use. NEVER commit .env.
# Empty AI keys = fully offline mode (curated knowledge base + templates).
# ---------------------------------------------------------------------------

# AI research + script writing (OpenAI-compatible: OpenAI / Groq / Together / Ollama)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Image generation (optional). Empty => FFmpeg cinematic plates + Wikimedia images.
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# Existing local voice repository (King Voice 👑). Auto-detected if omitted.
KINGVOICE_REPO_PATH=../kingvoice
VOICE_ENGINE=auto

# External asset storage (local | s3). Large MP4/MP3 files stay OUT of git.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Dashboard (3D thumbnail studio)
DASHBOARD_PORT=8080

# Runtime root (defaults to this repository)
AUTOMATION_ROOT=
